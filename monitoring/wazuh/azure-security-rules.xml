<group name="azure_security_lab,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="service">^azure-security-lab$</field>
    <description>Azure Security Lab: $(event)</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^authentication_failure$</field>
    <description>Azure Security Lab: API authentication failed</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^authentication_success$</field>
    <description>Azure Security Lab: API authentication succeeded</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100105" level="10" frequency="5" timeframe="60" ignore="60">
    <if_sid>100101</if_sid>
    <if_matched_sid>100101</if_matched_sid>
    <same_field>service</same_field>
    <same_field>environment</same_field>
    <description>Azure Security Lab: repeated API authentication failures within 60 seconds (application-wide)</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100103" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^note_created$</field>
    <description>Azure Security Lab: note created</description>
  </rule>

  <rule id="100104" level="3">
    <if_sid>100100</if_sid>
    <field name="event">^note_deleted$</field>
    <description>Azure Security Lab: note deleted</description>
  </rule>
</group>
